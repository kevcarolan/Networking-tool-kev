# Copy to .env (Docker) or /etc/netops/netops.env (systemd) and fill in.

# --- Product ---------------------------------------------------------------
# Name shown in the browser title, the page header and upgrade reports
# NETOPS_PRODUCT_NAME=NetOps Tools

# --- Settings page -----------------------------------------------------------
# The lines marked "(Settings page)" below are normally set by an admin on the Settings
# page: the customer or site name and the day-to-day defaults. A value set here wins and
# is shown there as "set in netops.env". Leave them commented out to use the Settings page.
# (Settings page) customer or site name, shown next to the product name and on reports
# NETOPS_SITE_NAME=

# --- Web server ------------------------------------------------------------
# Where 'python -m app' listens (development and trials). Default 127.0.0.1:8710.
# The installed service always uses 127.0.0.1:8710 behind nginx: to change it, change
# deploy/netops.service, the nginx site and APP_PORT in deploy/airgap/install.sh together.
# NETOPS_HOST=127.0.0.1
# NETOPS_PORT=8710
# The wall display's port, used for the links on the Settings page. It must match "listen"
# in /etc/nginx/sites-available/netops-display and the firewall rule.
# NETOPS_DISPLAY_PORT=8443

# --- Storage ---------------------------------------------------------------
# NETOPS_DATA_DIR=/var/lib/netops
# Keep the credential key OUTSIDE the data folder and back it up separately:
# without it, stored device passwords cannot be decrypted.
NETOPS_CREDENTIAL_KEY_FILE=/etc/netops/credential.key

# --- Web sessions ----------------------------------------------------------
# true when served over HTTPS (behind Caddy/nginx) - recommended
NETOPS_SESSION_HTTPS_ONLY=true
NETOPS_SESSION_MAX_AGE_HOURS=12
# Interactive API docs at /docs; keep off in production
NETOPS_API_DOCS=false

# --- Active Directory ------------------------------------------------------
# Normally set on the first-run setup screen (and later on the Settings page). A value
# set here wins over the screen and can't be changed there. Examples:
# NETOPS_LDAP_URL=ldaps://dc1.corp.local
# NETOPS_LDAP_DOMAIN=corp.local
# NETOPS_LDAP_BASE_DN=DC=corp,DC=local
# NETOPS_LDAP_ADMIN_GROUP=CN=NetOps-Admins,OU=Groups,DC=corp,DC=local
# NETOPS_LDAP_VIEWER_GROUP=CN=NetOps-Viewers,OU=Groups,DC=corp,DC=local
# Members may plan and run firmware upgrade jobs (on top of admin or viewer).
# Set this in production. If it is empty, admins can run upgrades.
# NETOPS_LDAP_UPGRADER_GROUP=CN=NetOps-Upgraders,OU=Groups,DC=corp,DC=local
# CA certificate that signed the domain controllers' LDAPS certificates
# NETOPS_LDAP_CA_FILE=/etc/netops/corp-root-ca.pem

# --- Break-glass local admin (works when AD is down) ------------------------
# Optional: the setup screen creates the first admin. Generate with:
#   python -m app.cli hash-password
NETOPS_LOCAL_ADMIN_USER=admin
NETOPS_LOCAL_ADMIN_PASSWORD_HASH=

# --- Backup engine -----------------------------------------------------------
NETOPS_BACKUP_WORKERS=10
# (Settings page) NETOPS_DEFAULT_FREQUENCY_MINUTES=1440
# (Settings page) NETOPS_FAILURE_RETRY_MINUTES=60
NETOPS_SSH_TIMEOUT=30
NETOPS_COMMAND_TIMEOUT=180
# (Settings page) NETOPS_HISTORY_RETENTION_DAYS=90
# Configs contain password hashes/keys; by default only admins can read them.
# (Settings page) NETOPS_VIEWERS_CAN_READ_CONFIGS=false

# --- Firmware tool -----------------------------------------------------------
# How often each device's software version is re-read (minutes)
# (Settings page) NETOPS_FIRMWARE_CHECK_MINUTES=1440
NETOPS_FIRMWARE_WORKERS=5
# Largest image upload accepted (MB)
NETOPS_FIRMWARE_MAX_UPLOAD_MB=4096
# An upload is refused when it would leave less than this much free disk (MB), so the
# database, backups and logs on the same disk keep working
NETOPS_FIRMWARE_KEEP_FREE_MB=2048

# --- Upgrade jobs ------------------------------------------------------------
# Jobs that can run checks at the same time (one per device)
NETOPS_UPGRADE_WORKERS=2
# Pre-check warnings (not blockers) above these CPU and memory percentages
# (Settings page) NETOPS_UPGRADE_CPU_WARN=80
# (Settings page) NETOPS_UPGRADE_MEM_WARN=85
# Free flash needed = image size x factor (IOS-XE install mode unpacks the image)
NETOPS_UPGRADE_FLASH_FACTOR=1.1
NETOPS_UPGRADE_FLASH_FACTOR_INSTALL=2.2
# A config backup older than this is taken again before an upgrade
# (Settings page) NETOPS_UPGRADE_BACKUP_MAX_AGE_HOURS=24
# Platforms allowed to run LIVE upgrades, comma-separated (or platform:path, e.g.
# cisco_ftd:fdm_ha). Empty = every job is a dry run. Add a platform only after it has
# passed docs/upgrade-lab-tests.md. Platforms: cisco_ios, cisco_nxos, cisco_asa,
# cisco_ftd, allied_awplus, and (built from vendor documentation, lab test first)
# arista_eos, juniper_junos, aruba_osswitch, aruba_aos8, dell_os10, extreme_exos,
# huawei_vrp, cisco_xr, mikrotik_routeros, ubiquiti_edgeos, fortinet_fortios (or
# fortinet_fortios:ha_cluster), paloalto_panos (or paloalto_panos:ha_pair)
NETOPS_UPGRADE_LIVE_PLATFORMS=
# IOS-XE: the switch reverts by itself unless the new version is committed in time
NETOPS_UPGRADE_ABORT_TIMER_MIN=120
# How long to wait for a device to reload and come back (FTD gets 3x this)
NETOPS_UPGRADE_RELOAD_TIMEOUT_MIN=30
# Wait after a device is back before running the post-checks
NETOPS_UPGRADE_SETTLE_SECONDS=120
# Image copy and install commands
NETOPS_UPGRADE_COPY_TIMEOUT_MIN=60

# --- Circuits ----------------------------------------------------------------
# When to read every device's MAC and ARP tables to find where each circuit really is
# (server local time). "daily 03:00" (every night, the default), "sun 02:00" (weekly), or empty.
# Upgrade jobs always read their own device. Uses each device's backup account.
# (Settings page) NETOPS_CIRCUIT_SCAN_SCHEDULE=daily 03:00
NETOPS_CIRCUIT_SCAN_WORKERS=5

# --- Syslog (the netops-syslog service; docs/syslog.md) -------------------------
# Ports the receiver listens on (0 = off) and the address it listens on ("::" for IPv6 too)
NETOPS_SYSLOG_UDP_PORT=514
NETOPS_SYSLOG_TCP_PORT=514
NETOPS_SYSLOG_BIND=0.0.0.0
# Syslog over TLS (RFC 5425): 6514 to switch it on, 0 = off. Uses the web server's certificate
# (it must name the address or name the devices use), unless the two lines below name others
# (readable by the netops account). Then: sudo systemctl restart netops-syslog
NETOPS_SYSLOG_TLS_PORT=0
# NETOPS_SYSLOG_TLS_CERT=/etc/netops/syslog-tls/syslog.crt
# NETOPS_SYSLOG_TLS_KEY=/etc/netops/syslog-tls/syslog.key
# Require a certificate from every device, signed by this CA (PEM). Empty = devices don't need one
# NETOPS_SYSLOG_TLS_CLIENT_CA=/etc/netops/syslog-tls/devices-ca.pem
# (Settings page) how long and how much to keep; whether to drop senders not in the inventory
# NETOPS_SYSLOG_KEEP_DAYS=30
# NETOPS_SYSLOG_MAX_GB=20
# NETOPS_SYSLOG_INVENTORY_ONLY=false
# Stop storing while less than this much disk is free (MB)
NETOPS_SYSLOG_KEEP_FREE_MB=2048
# Messages a second one sender may send; more are dropped and counted
NETOPS_SYSLOG_RATE_PER_SOURCE=2000
