# NetOps syslog receiver (systemd). Installed by deploy/airgap/install.sh.
# Listens on UDP and TCP 514 for the devices' log messages and keeps them in
# /var/lib/netops/syslog/ (one file per day; the Syslog page reads them).
# A separate service, so restarting or upgrading the web app never loses messages.
# Its only extra right is to listen on a port below 1024 (CAP_NET_BIND_SERVICE).
# Syslog over TLS (NETOPS_SYSLOG_TLS_PORT=6514 in netops.env) uses the web server's
# certificate: systemd reads it as root and hands the service a private copy
# (LoadCredential), so the key in /etc/netops/tls stays root-only. A new certificate
# from the setup screen restarts this service (netops-tls-apply).
# Check the sandboxing with:  systemd-analyze security netops-syslog
[Unit]
Description=NetOps syslog receiver
After=network-online.target
Wants=network-online.target

[Service]
User=netops
Group=netops
WorkingDirectory=/opt/netops/current/backend
EnvironmentFile=/etc/netops/netops.env
Environment=NETOPS_DATA_DIR=/var/lib/netops NETOPS_CREDENTIAL_KEY_FILE=/etc/netops/credential.key
ExecStart=/opt/netops/current/venv/bin/python -m app.tools.syslog
LoadCredential=tls.crt:/etc/netops/tls/netops.crt
LoadCredential=tls.key:/etc/netops/tls/netops.key
SyslogIdentifier=netops-syslog
Restart=always
RestartSec=5
UMask=0027

# Sandboxing: the service can write only to its data folder, sees no home
# folders or devices, and keeps no privileges beyond binding port 514.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/netops
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
