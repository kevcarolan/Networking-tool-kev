[Unit]
Description=NetOps Tools: install a new web certificate for nginx
After=nginx.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/netops-tls-apply
# Runs as root (it installs into /etc/netops/tls and reloads nginx), so keep it small.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
PrivateDevices=yes
